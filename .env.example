# OpenAQ (get from https://explore.openaq.org/register)
OPENAQ_API_KEY=723f4dc04f8e7f0664f92f8aa6baf2dd44b505632fcdb4fece2bef0af9994038

# AWS (for full deployment)
AWS_REGION=us-east-1
